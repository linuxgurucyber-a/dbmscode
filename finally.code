# Exercise 9 - Stored procedures and a stored function

## ex9.code

```sql
CREATE DATABASE IF NOT EXISTS dbms_ex09_routines;
USE dbms_ex09_routines;

DROP PROCEDURE IF EXISTS InsertStudent;
DROP PROCEDURE IF EXISTS UpdateStudent;
DROP PROCEDURE IF EXISTS DeleteStudent;
DROP FUNCTION IF EXISTS GetGrade;
DROP TABLE IF EXISTS Student;

CREATE TABLE Student (
    Student_ID INT PRIMARY KEY,
    Name VARCHAR(50) NOT NULL,
    Marks INT NOT NULL CHECK (Marks BETWEEN 0 AND 100)
);

DELIMITER //

CREATE PROCEDURE InsertStudent(
    IN p_ID INT,
    IN p_Name VARCHAR(50),
    IN p_Marks INT
)
BEGIN
    INSERT INTO Student (Student_ID, Name, Marks)
    VALUES (p_ID, p_Name, p_Marks);
END//

CREATE PROCEDURE UpdateStudent(
    IN p_ID INT,
    IN p_Marks INT
)
BEGIN
    UPDATE Student
    SET Marks = p_Marks
    WHERE Student_ID = p_ID;
END//

CREATE PROCEDURE DeleteStudent(IN p_ID INT)
BEGIN
    DELETE FROM Student
    WHERE Student_ID = p_ID;
END//

CREATE FUNCTION GetGrade(p_Marks INT)
RETURNS VARCHAR(2)
DETERMINISTIC
NO SQL
BEGIN
    IF p_Marks >= 90 THEN
        RETURN 'A+';
    ELSEIF p_Marks >= 80 THEN
        RETURN 'A';
    ELSEIF p_Marks >= 70 THEN
        RETURN 'B';
    ELSEIF p_Marks >= 60 THEN
        RETURN 'C';
    ELSE
        RETURN 'F';
    END IF;
END//

DELIMITER ;

CALL InsertStudent(101, 'Arun', 85);
CALL InsertStudent(102, 'Priya', 95);
SELECT * FROM Student ORDER BY Student_ID;

CALL UpdateStudent(101, 92);
SELECT * FROM Student ORDER BY Student_ID;

SELECT Name, Marks, GetGrade(Marks) AS Grade
FROM Student
ORDER BY Student_ID;

CALL DeleteStudent(102);
SELECT * FROM Student ORDER BY Student_ID;
```

# Exercise 10 - Transactions and access control

## ex10.code

```sql
CREATE DATABASE IF NOT EXISTS dbms_ex10_transactions;
USE dbms_ex10_transactions;

DROP TABLE IF EXISTS Account;

CREATE TABLE Account (
    Account_ID INT PRIMARY KEY,
    Name VARCHAR(50) NOT NULL,
    Balance DECIMAL(10,2) NOT NULL
) ENGINE = InnoDB;

INSERT INTO Account (Account_ID, Name, Balance) VALUES
(101, 'Arun', 10000.00),
(102, 'Priya', 8000.00);

-- A. Starting balances
SELECT * FROM Account ORDER BY Account_ID;

-- B. COMMIT: transfer 1000 from account 101 to account 102
START TRANSACTION;
UPDATE Account SET Balance = Balance - 1000.00 WHERE Account_ID = 101;
UPDATE Account SET Balance = Balance + 1000.00 WHERE Account_ID = 102;
COMMIT;
SELECT * FROM Account ORDER BY Account_ID;

-- C. ROLLBACK: undo this uncommitted 500 deduction
START TRANSACTION;
UPDATE Account SET Balance = Balance - 500.00 WHERE Account_ID = 101;
ROLLBACK;
SELECT * FROM Account ORDER BY Account_ID;

-- D. SAVEPOINT: keep the first deduction and undo the second
START TRANSACTION;
UPDATE Account SET Balance = Balance - 500.00 WHERE Account_ID = 101;
SAVEPOINT sp1;
UPDATE Account SET Balance = Balance - 1000.00 WHERE Account_ID = 102;
ROLLBACK TO SAVEPOINT sp1;
COMMIT;
SELECT * FROM Account ORDER BY Account_ID;

-- E. GRANT: run as a MySQL administrator; replace this sample password.
CREATE USER IF NOT EXISTS 'student_user'@'localhost'
IDENTIFIED BY 'ReplaceWithYourStrongPassword';

GRANT SELECT, INSERT, UPDATE
ON dbms_ex10_transactions.Account
TO 'student_user'@'localhost';

SHOW GRANTS FOR 'student_user'@'localhost';

-- F. REVOKE the INSERT privilege
REVOKE INSERT
ON dbms_ex10_transactions.Account
FROM 'student_user'@'localhost';

SHOW GRANTS FOR 'student_user'@'localhost';
```

# Exercise 11 - INSERT, UPDATE, and DELETE triggers

## ex11.code

```sql
CREATE DATABASE IF NOT EXISTS dbms_ex11_triggers;
USE dbms_ex11_triggers;

DROP TRIGGER IF EXISTS After_Student_Insert;
DROP TRIGGER IF EXISTS After_Student_Update;
DROP TRIGGER IF EXISTS After_Student_Delete;
DROP TABLE IF EXISTS Student;
DROP TABLE IF EXISTS Student_Audit;

CREATE TABLE Student (
    Student_ID INT PRIMARY KEY,
    Name VARCHAR(50) NOT NULL,
    Marks INT NOT NULL CHECK (Marks BETWEEN 0 AND 100)
);

CREATE TABLE Student_Audit (
    Audit_ID INT AUTO_INCREMENT PRIMARY KEY,
    Student_ID INT NOT NULL,
    Action_Type VARCHAR(20) NOT NULL,
    Old_Marks INT NULL,
    New_Marks INT NULL,
    Action_Time TIMESTAMP NOT NULL DEFAULT CURRENT_TIMESTAMP
);

DELIMITER //

CREATE TRIGGER After_Student_Insert
AFTER INSERT ON Student
FOR EACH ROW
BEGIN
    INSERT INTO Student_Audit (Student_ID, Action_Type, New_Marks)
    VALUES (NEW.Student_ID, 'INSERT', NEW.Marks);
END//

CREATE TRIGGER After_Student_Update
AFTER UPDATE ON Student
FOR EACH ROW
BEGIN
    INSERT INTO Student_Audit (Student_ID, Action_Type, Old_Marks, New_Marks)
    VALUES (OLD.Student_ID, 'UPDATE', OLD.Marks, NEW.Marks);
END//

CREATE TRIGGER After_Student_Delete
AFTER DELETE ON Student
FOR EACH ROW
BEGIN
    INSERT INTO Student_Audit (Student_ID, Action_Type, Old_Marks)
    VALUES (OLD.Student_ID, 'DELETE', OLD.Marks);
END//

DELIMITER ;

INSERT INTO Student (Student_ID, Name, Marks) VALUES (101, 'Arun', 85);
UPDATE Student SET Marks = 95 WHERE Student_ID = 101;
DELETE FROM Student WHERE Student_ID = 101;

SELECT Audit_ID, Student_ID, Action_Type, Old_Marks, New_Marks, Action_Time
FROM Student_Audit
ORDER BY Audit_ID;
```

# Exercise 12 - Department-wise student count and average marks

## ex12.code

```sql
CREATE DATABASE IF NOT EXISTS dbms_ex12_report;
USE dbms_ex12_report;

DROP TABLE IF EXISTS Student;

CREATE TABLE Student (
    Student_ID INT PRIMARY KEY,
    Name VARCHAR(50) NOT NULL,
    Department VARCHAR(30) NOT NULL,
    Marks INT NOT NULL
);

INSERT INTO Student (Student_ID, Name, Department, Marks) VALUES
(101, 'Arun', 'CSE', 85),
(102, 'Priya', 'IT', 90),
(103, 'Kumar', 'CSE', 75),
(104, 'Divya', 'ECE', 88),
(105, 'Ravi', 'IT', 70),
(106, 'Meena', 'ECE', 92);

