    Student_ID INT PRIMARY KEY,
    Name VARCHAR(50) NOT NULL,
    Department VARCHAR(30) NOT NULL,
    Marks INT NOT NULL
);

INSERT INTO Student (Student_ID, Name, Department, Marks) VALUES
(101, 'Arun', 'CSE', 85),
(102, 'Priya', 'IT', 90),
(103, 'Kumar', 'CSE', 75),
(104, 'Divya', 'ECE', 88),
(105, 'Ravi', 'IT', 70);

CREATE INDEX idx_student_name ON Student (Name);
CREATE INDEX idx_student_department ON Student (Department);
CREATE INDEX idx_department_marks ON Student (Department, Marks);

SELECT * FROM Student WHERE Name = 'Priya';
SELECT * FROM Student WHERE Department = 'CSE';
SELECT * FROM Student WHERE Department = 'CSE' AND Marks > 80;

SHOW INDEX FROM Student;
EXPLAIN SELECT * FROM Student WHERE Name = 'Priya';
```

# Exercise 14 - Student course registration with primary and foreign keys

## ex14.code

```sql
CREATE DATABASE IF NOT EXISTS dbms_ex14_registration;
USE dbms_ex14_registration;

DROP TABLE IF EXISTS Registration;
DROP TABLE IF EXISTS Course;
DROP TABLE IF EXISTS Student;

CREATE TABLE Student (
    Student_ID INT PRIMARY KEY,
    Student_Name VARCHAR(50) NOT NULL,
    Department VARCHAR(30)
);

CREATE TABLE Course (
    Course_ID INT PRIMARY KEY,
    Course_Name VARCHAR(50) NOT NULL,
    Credits INT NOT NULL CHECK (Credits > 0)
);

CREATE TABLE Registration (
    Registration_ID INT PRIMARY KEY,
    Student_ID INT NOT NULL,
    Course_ID INT NOT NULL,
    Registration_Date DATE NOT NULL,
    CONSTRAINT uq_student_course UNIQUE (Student_ID, Course_ID),
    FOREIGN KEY (Student_ID) REFERENCES Student(Student_ID),
    FOREIGN KEY (Course_ID) REFERENCES Course(Course_ID)
);

INSERT INTO Student (Student_ID, Student_Name, Department) VALUES
(101, 'Arun', 'CSE'),
(102, 'Priya', 'IT'),
(103, 'Kumar', 'CSE');

INSERT INTO Course (Course_ID, Course_Name, Credits) VALUES
(201, 'DBMS', 4),
(202, 'Computer Networks', 3),
(203, 'Cyber Security', 4);

INSERT INTO Registration (Registration_ID, Student_ID, Course_ID, Registration_Date) VALUES
(1, 101, 201, CURRENT_DATE),
(2, 101, 203, CURRENT_DATE),
(3, 102, 202, CURRENT_DATE),
(4, 103, 201, CURRENT_DATE);

SELECT
    S.Student_ID,
    S.Student_Name,
    C.Course_Name,
    R.Registration_Date
FROM Registration AS R
INNER JOIN Student AS S ON R.Student_ID = S.Student_ID
INNER JOIN Course AS C ON R.Course_ID = C.Course_ID
ORDER BY S.Student_ID, C.Course_ID;
```

# Exercise 15 - Transfer money between two accounts

## ex15.code

```sql
CREATE DATABASE IF NOT EXISTS dbms_ex15_banking;
USE dbms_ex15_banking;

DROP PROCEDURE IF EXISTS TransferMoney;
DROP TABLE IF EXISTS Account;

CREATE TABLE Account (
    Account_ID INT PRIMARY KEY,
    Account_Name VARCHAR(50) NOT NULL,
    Balance DECIMAL(10,2) NOT NULL CHECK (Balance >= 0)
) ENGINE = InnoDB;

INSERT INTO Account (Account_ID, Account_Name, Balance) VALUES
(101, 'Arun', 10000.00),
(102, 'Priya', 5000.00);

DELIMITER //

CREATE PROCEDURE TransferMoney(
    IN p_FromAccount INT,
    IN p_ToAccount INT,
    IN p_Amount DECIMAL(10,2)
)
BEGIN
    DECLARE v_Balance DECIMAL(10,2);
    DECLARE v_AccountCount INT DEFAULT 0;
    DECLARE v_LockedAccount INT;
    DECLARE v_TransactionStarted BOOLEAN DEFAULT FALSE;

    DECLARE EXIT HANDLER FOR SQLEXCEPTION
    BEGIN
        IF v_TransactionStarted THEN
            ROLLBACK;
        END IF;
        RESIGNAL;
    END;

    IF p_Amount IS NULL OR p_Amount <= 0 THEN
        SIGNAL SQLSTATE '45000'
            SET MESSAGE_TEXT = 'Amount must be positive';
    END IF;

    IF p_FromAccount IS NULL OR p_ToAccount IS NULL
       OR p_FromAccount = p_ToAccount THEN
        SIGNAL SQLSTATE '45000'
            SET MESSAGE_TEXT = 'Enter two different valid account numbers';
    END IF;

    START TRANSACTION;
    SET v_TransactionStarted = TRUE;

    SELECT COUNT(*) INTO v_AccountCount
    FROM Account
    WHERE Account_ID IN (p_FromAccount, p_ToAccount);

    IF v_AccountCount <> 2 THEN
        SIGNAL SQLSTATE '45000'
            SET MESSAGE_TEXT = 'Invalid account number';
    END IF;

    -- Lock both rows in ascending account order
    IF p_FromAccount < p_ToAccount THEN
        SELECT Account_ID INTO v_LockedAccount
        FROM Account WHERE Account_ID = p_FromAccount FOR UPDATE;
        SELECT Account_ID INTO v_LockedAccount
        FROM Account WHERE Account_ID = p_ToAccount FOR UPDATE;
    ELSE
        SELECT Account_ID INTO v_LockedAccount
        FROM Account WHERE Account_ID = p_ToAccount FOR UPDATE;
        SELECT Account_ID INTO v_LockedAccount
        FROM Account WHERE Account_ID = p_FromAccount FOR UPDATE;
    END IF;

    SELECT Balance INTO v_Balance
    FROM Account
    WHERE Account_ID = p_FromAccount;

    IF v_Balance < p_Amount THEN
        SIGNAL SQLSTATE '45000'
            SET MESSAGE_TEXT = 'Insufficient balance';
    END IF;

    UPDATE Account
    SET Balance = Balance - p_Amount
    WHERE Account_ID = p_FromAccount;

    UPDATE Account
    SET Balance = Balance + p_Amount
    WHERE Account_ID = p_ToAccount;

    COMMIT;
    SET v_TransactionStarted = FALSE;
END//

DELIMITER ;

SELECT * FROM Account ORDER BY Account_ID;
CALL TransferMoney(101, 102, 2000.00);
SELECT * FROM Account ORDER BY Account_ID;
```