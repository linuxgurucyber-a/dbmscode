# Exercise 1 - DDL: Create, alter, truncate, and drop
## ex1.code

```sql
CREATE DATABASE IF NOT EXISTS dbms_ex01_ddl;
USE dbms_ex01_ddl;

DROP TABLE IF EXISTS Student;

CREATE TABLE Student (
    Student_ID INT PRIMARY KEY,
    Name VARCHAR(50) NOT NULL,
    Department VARCHAR(30),
    Age INT,
    Marks INT
);

ALTER TABLE Student
ADD Email VARCHAR(100);

INSERT INTO Student (Student_ID, Name, Department, Age, Marks, Email)
VALUES (101, 'Arun', 'CSE', 20, 85, 'arun@example.com');

SHOW COLUMNS FROM Student;
SELECT * FROM Student;

TRUNCATE TABLE Student;
SELECT * FROM Student;

DROP TABLE Student;
SHOW TABLES;
```

