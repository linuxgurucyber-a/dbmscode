# Exercise 3 - WHERE clauses and aggregate functions

## ex3.code

```sql
CREATE DATABASE IF NOT EXISTS dbms_ex03_aggregates;
USE dbms_ex03_aggregates;

DROP TABLE IF EXISTS Student;

CREATE TABLE Student (
    Student_ID INT PRIMARY KEY,
    Name VARCHAR(50) NOT NULL,
    Department VARCHAR(30),
    Age INT,
    Marks INT
);

INSERT INTO Student (Student_ID, Name, Department, Age, Marks) VALUES
(101, 'Arun', 'CSE', 20, 85),
(102, 'Priya', 'IT', 21, 90),
(103, 'Kumar', 'CSE', 20, 75),
(104, 'Divya', 'ECE', 22, 88),
(105, 'Ravi', 'IT', 21, 65);

SELECT * FROM Student WHERE Marks > 80;
SELECT * FROM Student WHERE Department = 'CSE';

SELECT COUNT(*) AS Total_Students FROM Student;
SELECT MAX(Marks) AS Highest_Mark FROM Student;
SELECT MIN(Marks) AS Lowest_Mark FROM Student;
SELECT ROUND(AVG(Marks), 2) AS Average_Mark FROM Student;
SELECT SUM(Marks) AS Total_Marks FROM Student;
```

# Exercise 4 - DISTINCT, ORDER BY, GROUP BY, HAVING, and LIKE

## ex4.code

```sql
CREATE DATABASE IF NOT EXISTS dbms_ex04_grouping;
USE dbms_ex04_grouping;

DROP TABLE IF EXISTS Student;

CREATE TABLE Student (
    Student_ID INT PRIMARY KEY,
    Name VARCHAR(50) NOT NULL,
    Department VARCHAR(30),
    Age INT,
    Marks INT
);

INSERT INTO Student (Student_ID, Name, Department, Age, Marks) VALUES
(101, 'Arun', 'CSE', 20, 85),
(102, 'Priya', 'IT', 21, 90),
(103, 'Kumar', 'CSE', 20, 75),
(104, 'Divya', 'ECE', 22, 88),
(105, 'Ravi', 'IT', 21, 65);

-- Unique departments
SELECT DISTINCT Department FROM Student;

-- Highest marks first
SELECT * FROM Student ORDER BY Marks DESC, Student_ID;

-- Count students in each department
SELECT Department, COUNT(*) AS Total_Students
FROM Student
GROUP BY Department
ORDER BY Department;

-- Departments with more than one student
SELECT Department, COUNT(*) AS Total_Students
FROM Student
GROUP BY Department
HAVING COUNT(*) > 1
ORDER BY Department;

-- Names starting with A, ending with a, or containing vi
SELECT * FROM Student WHERE Name LIKE 'A%';
SELECT * FROM Student WHERE Name LIKE '%a';
SELECT * FROM Student WHERE Name LIKE '%vi%';
```

# Exercise 5 - INNER, LEFT, RIGHT, and FULL OUTER JOIN

## ex5.code

```sql
CREATE DATABASE IF NOT EXISTS dbms_ex05_joins;
USE dbms_ex05_joins;

DROP TABLE IF EXISTS Student_Details;
DROP TABLE IF EXISTS Department;

CREATE TABLE Department (
    Dept_ID INT PRIMARY KEY,
    Dept_Name VARCHAR(30) NOT NULL
);

CREATE TABLE Student_Details (
    Student_ID INT PRIMARY KEY,
    Name VARCHAR(50) NOT NULL,
    Dept_ID INT NULL,
    FOREIGN KEY (Dept_ID) REFERENCES Department(Dept_ID)
);

INSERT INTO Department (Dept_ID, Dept_Name) VALUES
(1, 'CSE'),
(2, 'IT'),
(3, 'ECE'),
(4, 'MECH');

INSERT INTO Student_Details (Student_ID, Name, Dept_ID) VALUES
(101, 'Arun', 1),
(102, 'Priya', 2),
(103, 'Kumar', 1),
(104, 'Divya', 3),
(105, 'Ravi', NULL);

-- A. INNER JOIN: matching rows only
SELECT S.Student_ID, S.Name, D.Dept_Name
FROM Student_Details AS S
INNER JOIN Department AS D ON S.Dept_ID = D.Dept_ID
ORDER BY S.Student_ID;

-- B. LEFT JOIN: all students, including students without a department
SELECT S.Student_ID, S.Name, D.Dept_Name
FROM Student_Details AS S
LEFT JOIN Department AS D ON S.Dept_ID = D.Dept_ID
ORDER BY S.Student_ID;

-- C. RIGHT JOIN: all departments, including departments without students
SELECT S.Student_ID, S.Name, D.Dept_Name
FROM Student_Details AS S
RIGHT JOIN Department AS D ON S.Dept_ID = D.Dept_ID
ORDER BY D.Dept_ID, S.Student_ID;

-- D. FULL OUTER JOIN equivalent for MySQL:
SELECT S.Student_ID, S.Name, D.Dept_Name
FROM Student_Details AS S
LEFT JOIN Department AS D ON S.Dept_ID = D.Dept_ID
UNION ALL
SELECT S.Student_ID, S.Name, D.Dept_Name
FROM Department AS D
LEFT JOIN Student_Details AS S ON S.Dept_ID = D.Dept_ID
WHERE S.Student_ID IS NULL
ORDER BY Student_ID;
```

# Exercise 6 - Nested queries (subqueries)

## ex6.code

```sql
CREATE DATABASE IF NOT EXISTS dbms_ex06_subqueries;
USE dbms_ex06_subqueries;

DROP TABLE IF EXISTS Student;
DROP TABLE IF EXISTS Department;

CREATE TABLE Department (
    Dept_ID INT PRIMARY KEY,
    Dept_Name VARCHAR(30) NOT NULL UNIQUE
);

CREATE TABLE Student (
    Student_ID INT PRIMARY KEY,
    Name VARCHAR(50) NOT NULL,
    Dept_ID INT,
    Marks INT,
    FOREIGN KEY (Dept_ID) REFERENCES Department(Dept_ID)
);

INSERT INTO Department (Dept_ID, Dept_Name) VALUES
(1, 'CSE'),
(2, 'IT'),
(3, 'ECE');

INSERT INTO Student (Student_ID, Name, Dept_ID, Marks) VALUES
(101, 'Arun', 1, 85),
(102, 'Priya', 2, 90),
(103, 'Kumar', 1, 75),
(104, 'Divya', 3, 88),
(105, 'Ravi', 2, 65);

-- Students in the CSE department
SELECT * FROM Student
WHERE Dept_ID = (
    SELECT Dept_ID FROM Department WHERE Dept_Name = 'CSE'
);

-- Students with marks above the overall average
SELECT * FROM Student
WHERE Marks > (SELECT AVG(Marks) FROM Student);

-- Student or students with the highest marks
SELECT * FROM Student
WHERE Marks = (SELECT MAX(Marks) FROM Student);
```

# Exercise 7 - Pattern matching with LIKE, % and _

## ex7.code

```sql
CREATE DATABASE IF NOT EXISTS dbms_ex07_patterns;
USE dbms_ex07_patterns;

DROP TABLE IF EXISTS Student;

CREATE TABLE Student (
    Student_ID INT PRIMARY KEY,
    Name VARCHAR(50) NOT NULL,
    Department VARCHAR(30),
    Marks INT
);

INSERT INTO Student (Student_ID, Name, Department, Marks) VALUES
(101, 'Arun', 'CSE', 85),
(102, 'Priya', 'IT', 90),
(103, 'Kumar', 'CSE', 75),
(104, 'Divya', 'ECE', 88),
(105, 'Ravi', 'IT', 65);

-- Names starting with A
SELECT * FROM Student WHERE Name LIKE 'A%';

-- Names ending with a
SELECT * FROM Student WHERE Name LIKE '%a';

-- Names containing vi
SELECT * FROM Student WHERE Name LIKE '%vi%';

-- Names with exactly four characters
SELECT * FROM Student WHERE Name LIKE '____';

-- Names whose second character is r
SELECT * FROM Student WHERE Name LIKE '_r%';

-- Names starting with P
SELECT * FROM Student WHERE Name LIKE 'P%';
```

