## EX.NO: 1 – DATA DEFINITION COMMANDS

```sql
CREATE DATABASE a;
USE a;

CREATE TABLE stud (
    sname VARCHAR(30),
    sid VARCHAR(10),
    sage INT,
    sarea VARCHAR(20)
);

SHOW TABLES;
DESC stud;

ALTER TABLE stud ADD phoneno INT AFTER sage;
DESC stud;

ALTER TABLE stud MODIFY sage VARCHAR(20);
DESC stud;

ALTER TABLE stud DROP sage;
DESC stud;

TRUNCATE TABLE stud;
DROP TABLE stud;
DESC stud;


## EX.NO: 2 DATA MANIPULATION COMMANDS


CREATE DATABASE IF NOT EXISTS a;
USE a;

CREATE TABLE student (
    sn CHAR(20),
    regno INT,
    address VARCHAR(40)
);

INSERT INTO student VALUES ('shalini', 1001, 'second street, chennai-73');
INSERT INTO student VALUES ('vinosha', 1002, 'kurinji street, chennai-73');
INSERT INTO student VALUES ('bharani', 1003, 'first street, chennai-73');

SELECT * FROM student;

ALTER TABLE student ADD sid INT;

UPDATE student SET sid = 1 WHERE regno = 1001;
UPDATE student SET sid = 2 WHERE regno = 1002;
UPDATE student SET sid = 3 WHERE regno = 1003;

SELECT * FROM student;

SELECT * FROM student WHERE regno = 1001;
SELECT * FROM student WHERE regno = 1001 OR sid = 2;
SELECT * FROM student WHERE regno NOT IN (1001, 1002);

DELETE FROM student WHERE sid = 1;
SELECT * FROM student;


## EX.NO: 3. WHERE CLAUSE AND AGGREGATE FUNCTIONS



CREATE DATABASE IF NOT EXISTS a;
USE a;

