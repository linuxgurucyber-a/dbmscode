EX.NO: 7 – PATTERN MATCHING

CREATE DATABASE IF NOT EXISTS a;
USE a;

CREATE TABLE Products (
    product_id INT PRIMARY KEY,
    product_name VARCHAR(50) NOT NULL
);

INSERT INTO Products VALUES
(1,'Samsung Phone'),(2,'Sony TV'),(3,'Apple Watch'),
(4,'Cat Toy'),(5,'Cute Doll'),(6,'Ace Game');

SELECT * FROM Products WHERE product_name LIKE 'S%';
SELECT * FROM Products WHERE product_name LIKE '%apple%';
SELECT * FROM Products WHERE product_name LIKE 'C_t%';
SELECT * FROM Products WHERE product_name LIKE 'A%e';
SELECT * FROM Products WHERE product_name REGEXP '^S';
SELECT * FROM Products WHERE product_name REGEXP 'e$';
SELECT * FROM Products WHERE product_name REGEXP 'o+';

EX.NO: 8 – CONSTRAINTS



CREATE DATABASE IF NOT EXISTS a;
USE a;

CREATE TABLE Students (
    student_id INT PRIMARY KEY,
    student_name VARCHAR(50) NOT NULL,
    email VARCHAR(100) UNIQUE,
    age INT CHECK (age >= 18),
    course VARCHAR(50) DEFAULT 'B.Tech'
);

INSERT INTO Students VALUES
(1,'Arun','arun@gmail.com',20,'B.Tech'),
(2,'Priya','priya@gmail.com',21,DEFAULT),
(3,'Karthik','karthik@gmail.com',19,'B.Sc');

SELECT * FROM Students;

CREATE TABLE Departments (
    dept_id INT PRIMARY KEY,
    dept_name VARCHAR(50) NOT NULL
);

INSERT INTO Departments VALUES
(101,'Computer Science'),(102,'Electronics'),
(103,'Mechanical'),(104,'Civil');

CREATE TABLE Faculty (
    faculty_id INT PRIMARY KEY,
    faculty_name VARCHAR(50) NOT NULL,
    dept_id INT,
    FOREIGN KEY (dept_id) REFERENCES Departments(dept_id)
);

INSERT INTO Faculty VALUES
(1,'Dr. Ramesh',101),(2,'Dr. Priya',102),
(3,'Dr. Karthik',101),(4,'Dr. Anitha',104);

SELECT * FROM Faculty;



EX.NO: 9 – FUNCTIONS





CREATE DATABASE IF NOT EXISTS a;
USE a;

CREATE TABLE it (ID INT, Name VARCHAR(20), Dept INT);
INSERT INTO it VALUES (101,'xxx',4021),(102,'yyy',4031),(103,'yyy',4021);

CREATE FUNCTION Hi(eid INT) RETURNS CHAR(40) RETURN 'Super';
SELECT dept, Hi(101) FROM it;

DELIMITER //
CREATE FUNCTION Factorial(n INT)
RETURNS INT
DETERMINISTIC
BEGIN
    DECLARE fact INT DEFAULT 1;
    IF n <= 0 THEN RETURN 1; END IF;
    factorial_loop: LOOP
        SET fact = fact * n;
        SET n = n - 1;
        IF n < 1 THEN LEAVE factorial_loop; END IF;
    END LOOP;
    RETURN fact;
END //
DELIMITER ;

SELECT Factorial(5);


EX.NO: 10 – STORED PROCEDURES

CREATE DATABASE IF NOT EXISTS a;
USE a;

CREATE TABLE item (
    ITEMID INT,
    ACTUALPRICE INT,
    ORDID INT,
    PRODID INT
);

INSERT INTO item VALUES
(101,2500,500,201),(102,3000,1600,202),(103,4000,600,203);

DELIMITER //
CREATE PROCEDURE func_in(IN a INT)
BEGIN
    SELECT actualprice FROM item WHERE itemid = a;
END //
DELIMITER ;

CALL func_in(101);

DELIMITER //
CREATE PROCEDURE func_out(IN price INT, OUT Total_count INT)
BEGIN
    SELECT COUNT(*) INTO Total_count FROM item WHERE actualprice < price;
END //
DELIMITER ;

CALL func_out(4000, @Total_count);
SELECT @Total_count;

DELIMITER //
CREATE PROCEDURE func_inout(INOUT count INT, IN inc INT)
BEGIN
    SET count = count + inc;
END //
DELIMITER ;

SET @counter = 1;
CALL func_inout(@counter, 1);
CALL func_inout(@counter, 1);
CALL func_inout(@counter, 5);
SELECT @counter;



EX.NO: 11 – TRANSACTIONS, DCL AND TCL COMMANDS



CREATE DATABASE IF NOT EXISTS a;
USE a;

CREATE TABLE Account (
    AccNo INT PRIMARY KEY,
    Name VARCHAR(30),
    Balance INT
);

INSERT INTO Account VALUES (101,'Arun',5000),(102,'Bala',7000),(103,'Charan',8000);
SELECT * FROM Account;

START TRANSACTION;
UPDATE Account SET Balance = Balance - 1000 WHERE AccNo = 101;
SAVEPOINT S1;
UPDATE Account SET Balance = Balance + 1000 WHERE AccNo = 102;
SAVEPOINT S2;
DELETE FROM Account WHERE AccNo = 103;
ROLLBACK TO S1;
COMMIT;

SELECT * FROM Account;

CREATE USER 'student'@'localhost' IDENTIFIED BY 'stud123';
GRANT SELECT, INSERT ON Account TO 'student'@'localhost';
REVOKE INSERT ON Account FROM 'student'@'localhost';


EX.NO: 12 – SQL TRIGGERS FOR INSERT, DELETE AND UPDATE



CREATE DATABASE IF NOT EXISTS a;
USE a;

CREATE TABLE Employee (
    EmpID INT PRIMARY KEY,
    Name VARCHAR(30),
    Salary INT
);

CREATE TABLE Emp_Log (
    LogID INT AUTO_INCREMENT PRIMARY KEY,
    Action VARCHAR(20),
    EmpID INT,
    Name VARCHAR(30),
    ActionTime TIMESTAMP DEFAULT CURRENT_TIMESTAMP
);

CREATE TRIGGER after_employee_insert
AFTER INSERT ON Employee
FOR EACH ROW
INSERT INTO Emp_Log(Action, EmpID, Name)
VALUES ('INSERT', NEW.EmpID, NEW.Name);

CREATE TRIGGER after_employee_delete
AFTER DELETE ON Employee
FOR EACH ROW
INSERT INTO Emp_Log(Action, EmpID, Name)
VALUES ('DELETE', OLD.EmpID, OLD.Name);

CREATE TRIGGER after_employee_update
AFTER UPDATE ON Employee
FOR EACH ROW
INSERT INTO Emp_Log(Action, EmpID, Name)
VALUES ('UPDATE', NEW.EmpID, NEW.Name);

INSERT INTO Employee VALUES (101,'Arun',30000);
SELECT * FROM Emp_Log;

DELETE FROM Employee WHERE EmpID = 101;
SELECT * FROM Emp_Log;

INSERT INTO Employee VALUES (102,'Bala',35000);
UPDATE Employee SET Salary = 40000 WHERE EmpID = 102;
SELECT * FROM Emp_Log;
